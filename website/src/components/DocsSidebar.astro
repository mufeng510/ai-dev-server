---
import type { CollectionEntry } from "astro:content";
interface Props {
  docs: CollectionEntry<"docs">[];
  current: string;
}
const { docs, current } = Astro.props;
const normalize = (path: string) => path.replace(/\/$/, "") || "/";
---

<div class="mb-4 lg:hidden">
  <label for="docs-nav-select" class="mb-2 block text-sm font-medium">Documentation</label>
  <select
    id="docs-nav-select"
    class="w-full rounded-lg border border-[var(--color-border)] bg-[var(--color-card)] px-3 py-2"
    onchange="if (this.value) window.location.href = this.value"
  >
    {docs.map((doc) => {
      const href = doc.slug === "index" ? "/docs" : `/docs/${doc.slug}`;
      return (
        <option value={href} selected={normalize(current) === normalize(href)}>
          {doc.data.title}
        </option>
      );
    })}
  </select>
</div>

<nav class="hidden lg:block" aria-label="Documentation">
  <p class="mb-3 text-xs font-semibold uppercase tracking-wider text-[var(--color-muted)]">Docs</p>
  <ul class="space-y-1 p-0 list-none">
    {docs.map((doc) => {
      const href = doc.slug === "index" ? "/docs" : `/docs/${doc.slug}`;
      const active = normalize(current) === normalize(href);
      return (
        <li>
          <a
            href={href}
            class:list={[
              "block rounded-lg px-3 py-2 text-sm no-underline",
              active
                ? "bg-[var(--color-surface)] font-semibold text-[var(--color-fg)]"
                : "text-[var(--color-muted)] hover:bg-[var(--color-surface)] hover:text-[var(--color-fg)]",
            ]}
            aria-current={active ? "page" : undefined}
          >
            {doc.data.title}
          </a>
        </li>
      );
    })}
  </ul>
</nav>
