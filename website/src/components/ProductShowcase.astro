---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const items = [1,2,3].map((n) => ({
  title: t(locale, `showcase.${n}.title` as any),
  body: t(locale, `showcase.${n}.body` as any),
}));
---
<section class="border-y border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-surface)_55%,transparent)] py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{t(locale, "showcase.title")}</h2>
      <p class="mt-3 text-[var(--color-muted)]">{t(locale, "showcase.subtitle")}</p>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {items.map((item, index) => (
        <article class="card p-5">
          <div class="mb-4 overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-code)] p-4 font-mono text-xs text-slate-200">
            <p class="text-slate-400">{t(locale, "showcase.panel")} {index + 1}</p>
            <p>$ docker compose up -d</p>
            <p>$ scripts/shell</p>
            <p>$ scripts/exec ai-dev doctor</p>
          </div>
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>