---
const items = [
  {
    title: "Powerful enough for serious development",
    body: "Keep toolchains, AI CLIs, and project state together. Recreate the container without throwing away /workspace or /config.",
  },
  {
    title: "Run AI coding workflows without rebuilding every time",
    body: "Credentials and tool homes resolve through configuration generations so Claude, Codex, and gh keep working after restarts.",
  },
  {
    title: "Host access in, container shell next",
    body: "There is no in-container SSH daemon. Reach your Docker host first, then use scripts/shell or scripts/tmux for the supported dev identity.",
  },
];
---

<section class="border-y border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-surface)_55%,transparent)] py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">Built for durable AI coding sessions.</h2>
      <p class="mt-3 text-[var(--color-muted)]">Terminal-first by design — illustrated below, not presented as product screenshots.</p>
    </div>
    <div class="mt-10 grid gap-6 lg:grid-cols-3">
      {items.map((item, index) => (
        <article class="card p-5">
          <div class="mb-4 overflow-hidden rounded-lg border border-[var(--color-border)] bg-[var(--color-code)] p-4 font-mono text-xs text-slate-200">
            <p class="text-slate-400">// illustrative panel {index + 1}</p>
            <p>$ docker compose up -d</p>
            <p>$ scripts/shell</p>
            <p>$ scripts/exec ai-dev doctor</p>
          </div>
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>
