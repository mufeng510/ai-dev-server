---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const cases = [1,2,3,4].map((n) => ({
  title: t(locale, `use.${n}.title` as any),
  body: t(locale, `use.${n}.body` as any),
}));
---
<section id="use-cases" class="border-y border-[var(--color-border)] py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{t(locale, "use.title")}</h2>
      <p class="mt-3 text-[var(--color-muted)]">{t(locale, "use.subtitle")}</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2">
      {cases.map((item) => (
        <article class="card p-5">
          <h3 class="text-lg font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>