---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const agents = [1,2,3,4,5,6,7,8].map((n) => ({
  name: t(locale, `agents.${n}.name` as any),
  body: t(locale, `agents.${n}.body` as any),
}));
---
<section id="agents" class="border-y border-[var(--color-border)] py-20">
  <div class="container-page">
    <div class="mx-auto max-w-2xl text-center">
      <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{t(locale, "agents.title")}</h2>
      <p class="mt-3 text-[var(--color-muted)]">{t(locale, "agents.subtitle")}</p>
    </div>
    <div class="mt-10 grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {agents.map((agent) => (
        <article class="card p-5">
          <h3 class="text-lg font-semibold">{agent.name}</h3>
          <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{agent.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>