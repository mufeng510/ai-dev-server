---
import { siteConfig } from "../config/site";
import ThemeToggle from "./ThemeToggle.astro";
import MobileMenu from "./MobileMenu.astro";
---

<header
  class="sticky top-0 z-40 border-b border-[var(--color-border)] bg-[color-mix(in_oklab,var(--color-bg)_80%,transparent)] backdrop-blur-md"
>
  <div class="container-page flex h-16 items-center justify-between gap-4">
    <a href="/" class="flex items-center gap-2 font-semibold tracking-tight text-[var(--color-fg)] no-underline">
      <img src="/logo.svg" width="28" height="28" alt="" />
      <span>{siteConfig.name}</span>
    </a>
    <nav class="hidden items-center gap-6 md:flex" aria-label="Primary">
      {
        siteConfig.nav.map((item) => (
          <a
            href={item.href}
            class="text-sm text-[var(--color-muted)] no-underline transition hover:text-[var(--color-fg)]"
            {...(item.external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
          >
            {item.label}
            {item.external ? " ↗" : ""}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
    <div class="flex items-center gap-2 md:hidden">
      <ThemeToggle />
      <MobileMenu items={siteConfig.nav} />
    </div>
  </div>
</header>
