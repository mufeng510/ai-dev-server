---
import CodeBlock from "./CodeBlock.astro";
import { siteConfig } from "../config/site";
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/utils";
import { localePath } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const clone = `git clone ${siteConfig.github}.git\ncd ai-dev-server`;
const start = `docker compose up -d\n# optional:\n# PUID="$(id -u)" PGID="$(id -g)" TZ=Asia/Shanghai docker compose up -d\n# AI_DEV_IMAGE=docker.io/jerry0510/ai-dev:1.2.3 docker compose up -d`;
const enter = `scripts/shell\n# durable tmux session:\nscripts/tmux`;
---
<section id="quick-start" class="container-page py-20">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{t(locale, "quick.title")}</h2>
    <p class="mt-3 text-[var(--color-muted)]">
      {t(locale, "quick.subtitlePrefix")} <code class="font-mono text-xs">{siteConfig.image}</code>
    </p>
  </div>
  <div class="mx-auto mt-10 grid max-w-3xl gap-6">
    <div>
      <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-[var(--color-muted)]">{t(locale, "quick.step1")}</h3>
      <CodeBlock code={clone} locale={locale} />
    </div>
    <div>
      <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-[var(--color-muted)]">{t(locale, "quick.step2")}</h3>
      <CodeBlock code={start} locale={locale} />
    </div>
    <div>
      <h3 class="mb-2 text-sm font-semibold uppercase tracking-wide text-[var(--color-muted)]">{t(locale, "quick.step3")}</h3>
      <CodeBlock code={enter} locale={locale} />
      <p class="mt-3 text-sm text-[var(--color-muted)]">{t(locale, "quick.note")}</p>
    </div>
    <p class="text-center">
      <a class="text-[var(--color-accent)]" href={localePath(locale, "/docs/installation")}>{t(locale, "quick.docs")}</a>
    </p>
  </div>
</section>