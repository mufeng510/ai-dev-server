---
import { t } from "../i18n/ui";
import type { Locale } from "../i18n/utils";
interface Props { locale: Locale }
const { locale } = Astro.props;
const features = [1,2,3,4,5,6].map((n) => ({
  title: t(locale, `features.${n}.title` as any),
  body: t(locale, `features.${n}.body` as any),
}));
---
<section id="features" class="container-page py-20">
  <div class="mx-auto max-w-2xl text-center">
    <h2 class="text-3xl font-bold tracking-tight md:text-4xl">{t(locale, "features.title")}</h2>
    <p class="mt-3 text-[var(--color-muted)]">{t(locale, "features.subtitle")}</p>
  </div>
  <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {features.map((feature) => (
      <article class="card p-5">
        <h3 class="text-lg font-semibold">{feature.title}</h3>
        <p class="mt-2 text-sm leading-6 text-[var(--color-muted)]">{feature.body}</p>
      </article>
    ))}
  </div>
</section>