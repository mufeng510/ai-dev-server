---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Features from "../components/Features.astro";
import ProductShowcase from "../components/ProductShowcase.astro";
import HowItWorks from "../components/HowItWorks.astro";
import Agents from "../components/Agents.astro";
import QuickStart from "../components/QuickStart.astro";
import UseCases from "../components/UseCases.astro";
import FAQ from "../components/FAQ.astro";
import CTA from "../components/CTA.astro";
import { siteConfig } from "../config/site";
---

<Layout
  title={`${siteConfig.name} — Your AI Development Environment, Anywhere`}
  description={siteConfig.description}
  canonicalPath="/"
>
  <Hero />
  <Features />
  <ProductShowcase />
  <HowItWorks />
  <Agents />
  <QuickStart />
  <UseCases />
  <FAQ />
  <CTA />
</Layout>
