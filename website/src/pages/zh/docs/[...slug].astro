---
import { getCollection, type CollectionEntry } from "astro:content";
import DocsLayout from "../../../layouts/DocsLayout.astro";

const locale = "zh" as const;

export async function getStaticPaths() {
  const docs = await getCollection("docs");
  return docs
    .filter((doc) => doc.id.startsWith("zh/"))
    .map((doc) => {
      const localSlug = doc.id.replace(/^zh\//, "").replace(/\.mdx?$/, "");
      const param = localSlug === "index" ? undefined : localSlug;
      return { params: { slug: param }, props: { doc, localSlug } };
    });
}

type Props = { doc: CollectionEntry<"docs">; localSlug: string };
const { doc } = Astro.props;
const { Content } = await doc.render();
---
<DocsLayout locale={locale} title={doc.data.title} description={doc.data.description}>
  <h1>{doc.data.title}</h1>
  <Content />
</DocsLayout>