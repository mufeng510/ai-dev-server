---
import Layout from "../../layouts/Layout.astro";
import Hero from "../../components/Hero.astro";
import Features from "../../components/Features.astro";
import ProductShowcase from "../../components/ProductShowcase.astro";
import HowItWorks from "../../components/HowItWorks.astro";
import Agents from "../../components/Agents.astro";
import QuickStart from "../../components/QuickStart.astro";
import UseCases from "../../components/UseCases.astro";
import FAQ from "../../components/FAQ.astro";
import CTA from "../../components/CTA.astro";
import { t } from "../../i18n/ui";

const locale = "zh" as const;
---
<Layout locale={locale} title={t(locale, "meta.title")} description={t(locale, "meta.description")} canonicalPath="/zh/">
  <Hero locale={locale} />
  <Features locale={locale} />
  <ProductShowcase locale={locale} />
  <HowItWorks locale={locale} />
  <Agents locale={locale} />
  <QuickStart locale={locale} />
  <UseCases locale={locale} />
  <FAQ locale={locale} />
  <CTA locale={locale} />
</Layout>