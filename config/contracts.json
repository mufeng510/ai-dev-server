{
  "schemaVersion": 1,
  "architectures": {
    "amd64": {
      "ccSwitchAssetKey": "CC_SWITCH_AMD64_ASSET",
      "ccSwitchChecksumKey": "CC_SWITCH_AMD64_SHA256"
    },
    "arm64": {
      "ccSwitchAssetKey": "CC_SWITCH_ARM64_ASSET",
      "ccSwitchChecksumKey": "CC_SWITCH_ARM64_SHA256"
    }
  },
  "persistence": [
    {
      "volume": "workspace",
      "path": "/workspace"
    },
    {
      "volume": "config",
      "path": "/config"
    },
    {
      "volume": "data",
      "path": "/data"
    },
    {
      "volume": "logs",
      "path": "/logs"
    },
    {
      "volume": "models",
      "path": "/models"
    },
    {
      "volume": "backups",
      "path": "/backups"
    }
  ],
  "managedRoutes": [
    {
      "homePath": ".config/claude-omc",
      "generationPath": "omc"
    },
    {
      "homePath": ".config/gh",
      "generationPath": "gh"
    },
    {
      "homePath": ".ssh",
      "generationPath": "ssh"
    },
    {
      "homePath": ".config/git",
      "generationPath": "git"
    },
    {
      "homePath": ".config/zsh",
      "generationPath": "zsh"
    },
    {
      "homePath": ".config/opencode",
      "generationPath": "opencode"
    },
    {
      "homePath": ".omo",
      "generationPath": "omo"
    },
    {
      "homePath": ".local/share/opencode",
      "generationPath": "opencode-data"
    }
  ],
  "stateMachines": {
    "initialization": [
      "lock",
      "create-mounts",
      "reconcile-identity",
      "copy-defaults",
      "report-auth-state",
      "setup-omx",
      "setup-opencode-omo",
      "verify-omc",
      "verify-cc-switch",
      "ready"
    ],
    "identityMigration": [
      "lock",
      "validate-source",
      "journal-target",
      "backup-metadata",
      "change-ownership",
      "verify-ownership",
      "commit-identity",
      "complete"
    ],
    "configurationMigration": [
      "lock",
      "resolve-active-generation",
      "hash-source",
      "stage-copy",
      "mutate-stage",
      "validate-stage",
      "hash-target",
      "commit-pointer",
      "complete"
    ]
  },
  "release": {
    "mainTags": [
      "edge",
      "sha-{shortSha}"
    ],
    "stableTags": [
      "v{version}",
      "{version}",
      "{major}.{minor}",
      "{major}",
      "{year}.{month}",
      "latest"
    ],
    "prereleaseTags": [
      "v{version}",
      "{version}"
    ],
    "movingChannels": [
      "{major}.{minor}",
      "{major}",
      "{year}.{month}",
      "latest"
    ]
  },
  "redaction": {
    "keyPatterns": [
      "token",
      "secret",
      "password",
      "authorization",
      "api_key",
      "private_key",
      "refresh_token"
    ],
    "valuePatterns": [
      "sk-[A-Za-z0-9_-]{8,}",
      "gh[pousr]_[A-Za-z0-9]{8,}",
      "Bearer\\s+[A-Za-z0-9._~+/-]+=*",
      "-----BEGIN [A-Z ]*PRIVATE KEY-----"
    ],
    "replacement": "[REDACTED]"
  }
}
