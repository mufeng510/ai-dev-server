#!/usr/bin/env bash
set -euo pipefail
umask 077
[ "$(id -u)" -eq 0 ] || { echo 'ai-dev-migrate: must run as root with the service stopped' >&2; exit 77; }
. /usr/local/libexec/ai-dev-runtime
exec 9>"${AI_DEV_LOCK}"
flock -n 9 || { echo 'ai-dev-migrate: service is running or another operation holds the lock' >&2; exit 75; }
journal="${AI_DEV_CONFIG_ROOT}/migration.journal"
recovering=0
ai_dev_resolve_generation
if [ -e "${journal}" ]; then
  [ -f "${journal}" ] && [ ! -L "${journal}" ] || ai_dev_die "migration journal is unsafe"
  operation_id="$(jq -er '.operation_id' "${journal}")"
  source_id="$(jq -er '.source' "${journal}")"
  target_id="$(jq -er '.target' "${journal}")"
  recorded_before_hash="$(jq -er '.before_hash' "${journal}")"
  ai_dev_safe_generation_id "${source_id}" && ai_dev_safe_generation_id "${target_id}" || ai_dev_die "migration journal contains unsafe generation ids"
  if [ "${AI_DEV_GENERATION_ID}" = "${target_id}" ]; then
    ai_dev_validate_generation "${target_id}" || ai_dev_die "committed migration target is unsafe"
    recorded_after_hash="$(jq -er '.after_hash' "${journal}")"
    [ "$(ai_dev_generation_hash "${AI_DEV_GENERATIONS}/${target_id}")" = "${recorded_after_hash}" ] ||
      ai_dev_die "committed migration target hash does not match the journal"
    ai_dev_event "${operation_id}" recovery.started warning recovery-required state configuration
    ai_dev_event_once "${operation_id}" config-migration.committed info migration-committed generation "${target_id}" previous_generation "${source_id}"
    ai_dev_event_once "${operation_id}" recovery.completed info recovery-completed state configuration generation "${target_id}"
    ai_dev_event_once "${operation_id}" config-migration.completed info migration-completed generation "${target_id}"
    ai_dev_event_once "${operation_id}" operation.completed info operation-completed
    rm -f "${journal}"
    ai_dev_sync_path "${AI_DEV_CONFIG_ROOT}"
    printf 'migration recovery complete: %s -> %s\n' "${source_id}" "${target_id}"
    exit 0
  fi
  [ "${AI_DEV_GENERATION_ID}" = "${source_id}" ] || ai_dev_die "migration journal does not match the active generation"
  [ "$(ai_dev_generation_hash "${AI_DEV_GENERATIONS}/${source_id}")" = "${recorded_before_hash}" ] ||
    ai_dev_die "migration source changed after the journal was written"
  recovering=1
  ai_dev_event "${operation_id}" recovery.started warning recovery-required state configuration
else
  operation_id="$(ai_dev_new_operation)"
  source_id="${AI_DEV_GENERATION_ID}"
  target_id="${1:-g$(date -u +%Y%m%dT%H%M%SZ)}"
  ai_dev_event "${operation_id}" config-migration.started info migration-started
fi
source_dir="${AI_DEV_GENERATIONS}/${source_id}"
ai_dev_safe_generation_id "${target_id}" || ai_dev_die "target generation id is unsafe"
[ "${target_id}" != "${source_id}" ] || ai_dev_die "target generation must differ from active generation"
target_dir="${AI_DEV_GENERATIONS}/${target_id}"
if [ -e "${target_dir}" ]; then
  [ "${recovering}" -eq 1 ] && [ -d "${target_dir}" ] && [ ! -L "${target_dir}" ] || ai_dev_die "target generation already exists or is unsafe"
  rm -rf -- "${target_dir}"
fi
before_hash="$(ai_dev_generation_hash "${source_dir}")"
jq -cn --arg operation_id "${operation_id}" --arg source "${source_id}" --arg target "${target_id}" \
  --arg before_hash "${before_hash}" '{schema_version:1,operation_id:$operation_id,source:$source,target:$target,before_hash:$before_hash,state:"staging"}' |
  ai_dev_atomic_write "${journal}" 0600
cp -a "${source_dir}" "${target_dir}"
printf '%s\n' "${AI_DEV_CONFIG_SCHEMA:-1}" | ai_dev_atomic_write "${target_dir}/schema-version" 0600
ai_dev_validate_generation "${target_id}" || ai_dev_die "staged generation is incomplete or unsafe"
target_uid="$(stat -c %u "${target_dir}/cc-switch")" target_gid="$(stat -c %g "${target_dir}/cc-switch")"
installed_omx_version="$(omx --version | sed -n '1p')"
recorded_omx_version="$(cat "${target_dir}/omx-initialized" 2>/dev/null || true)"
[ -n "${installed_omx_version}" ] || ai_dev_die "installed OMX version is unavailable"
if [ "${recorded_omx_version}" != "${installed_omx_version}" ]; then
  gosu "${target_uid}:${target_gid}" env HOME="${AI_DEV_HOME}" CODEX_HOME="${target_dir}/codex" CI=1 \
    npm_config_offline=true npm_config_update_notifier=false \
    omx setup --scope user --install-mode legacy --mcp none --team-mode enabled ||
    ai_dev_die "staged OMX setup failed"
  doctor_output="$(gosu "${target_uid}:${target_gid}" env HOME="${AI_DEV_HOME}" CODEX_HOME="${target_dir}/codex" CI=1 \
    npm_config_offline=true npm_config_update_notifier=false omx doctor)" ||
    ai_dev_die "staged OMX doctor failed"
  grep -Eq 'Results: [0-9]+ passed, [0-9]+ warnings, 0 failed' <<<"${doctor_output}" ||
    ai_dev_die "staged OMX doctor reported failed checks"
  printf '%s\n' "${installed_omx_version}" | ai_dev_atomic_write "${target_dir}/omx-initialized" 0600
  chown "${target_uid}:${target_gid}" "${target_dir}/omx-initialized"
fi
ai_dev_probe_generation_tools "${target_dir}" || ai_dev_die "staged generation tool probe failed"
ai_dev_secure_state "${target_dir}/cc-switch" || ai_dev_die "staged cc-switch permissions are unsafe"
after_hash="$(ai_dev_generation_hash "${target_dir}")"
jq -cn --arg operation_id "${operation_id}" --arg source "${source_id}" --arg target "${target_id}" \
  --arg before_hash "${before_hash}" --arg after_hash "${after_hash}" \
  '{schema_version:1,operation_id:$operation_id,source:$source,target:$target,before_hash:$before_hash,after_hash:$after_hash,state:"validated"}' |
  ai_dev_atomic_write "${journal}" 0600
install -d -m 0700 "${AI_DEV_BACKUP_ROOT}/generations"
printf '%s %s\n' "${source_id}" "${before_hash}" | ai_dev_atomic_write "${AI_DEV_BACKUP_ROOT}/generations/${source_id}.sha256" 0600
printf '%s\n' "${source_id}" | ai_dev_atomic_write "${AI_DEV_CONFIG_ROOT}/previous-generation" 0600
ai_dev_commit_pointer "${target_id}"
ai_dev_event "${operation_id}" config-migration.committed info migration-committed generation "${target_id}" previous_generation "${source_id}"
[ "${recovering}" -eq 0 ] || ai_dev_event "${operation_id}" recovery.completed info recovery-completed state configuration generation "${target_id}"
ai_dev_event "${operation_id}" config-migration.completed info migration-completed generation "${target_id}"
ai_dev_event "${operation_id}" operation.completed info operation-completed
rm -f "${journal}"
ai_dev_sync_path "${AI_DEV_CONFIG_ROOT}"
printf 'migration complete: %s -> %s\n' "${source_id}" "${target_id}"
